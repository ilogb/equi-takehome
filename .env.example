# Copy to .env (gitignored) and fill in. Never commit .env.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in
ALLOWED_EMAILS=
# Generate with `make keys`
SESSION_SECRET=
FERNET_KEY=
# Optional overrides (defaults shown)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# PUBLIC_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
# EXTRACTION_MODEL=gpt-6.1-sol
# MAPPING_MODEL=gpt-6.1-terra
# ANALYZE_MODEL=gpt-6.1-terra
# EMBEDDING_MODEL=text-embedding-3-small
# WORKER_CONCURRENCY=3
# POLL_SECONDS=60
